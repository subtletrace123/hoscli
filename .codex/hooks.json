{
  "description": "Branch policy checks for this repository.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.github/hooks/branch-policy.js\" codex",
            "commandWindows": "node -e 'const cp=require(`node:child_process`),p=require(`node:path`);process.argv[2]=`codex`;require(p.join(cp.execFileSync(`git`,[`rev-parse`,`--show-toplevel`],{encoding:`utf8`}).trim(),`.github`,`hooks`,`branch-policy.js`))'",
            "timeout": 5,
            "statusMessage": "Checking branch policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.github/hooks/branch-policy.js\" codex",
            "commandWindows": "node -e 'const cp=require(`node:child_process`),p=require(`node:path`);process.argv[2]=`codex`;require(p.join(cp.execFileSync(`git`,[`rev-parse`,`--show-toplevel`],{encoding:`utf8`}).trim(),`.github`,`hooks`,`branch-policy.js`))'",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.github/hooks/branch-policy.js\" codex",
            "commandWindows": "node -e 'const cp=require(`node:child_process`),p=require(`node:path`);process.argv[2]=`codex`;require(p.join(cp.execFileSync(`git`,[`rev-parse`,`--show-toplevel`],{encoding:`utf8`}).trim(),`.github`,`hooks`,`branch-policy.js`))'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.github/hooks/branch-policy.js\" codex",
            "commandWindows": "node -e 'const cp=require(`node:child_process`),p=require(`node:path`);process.argv[2]=`codex`;require(p.join(cp.execFileSync(`git`,[`rev-parse`,`--show-toplevel`],{encoding:`utf8`}).trim(),`.github`,`hooks`,`branch-policy.js`))'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}